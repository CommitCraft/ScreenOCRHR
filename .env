# ============================================================
# SCREEN OCR - MACHINE & API CONFIGURATION
# ============================================================

# Machine & Line Details
MACHINE_NAME=MC-04
LINE_NAME=Line-01

# API Server Settings
API_IP=127.0.0.1
API_PORT=1880
API_ENDPOINT=/api/screen-ocr
API_TIMEOUT=3

# Offline Sync & Reliability Settings
# SYNC_INTERVAL: seconds between periodic CSV sync runs (120 = 2 minutes)
SYNC_INTERVAL=120

# IMMEDIATE_SEND:
# true  = Send immediately on detection, and auto-retry any failed/pending logs in background every 2 minutes
# false = Buffer locally to ocr_log.csv first, then batch send every 2 minutes
IMMEDIATE_SEND=true
